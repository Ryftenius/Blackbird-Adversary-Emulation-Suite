    {
      "id": "ransomware-disabled",
      "kind": "detection",
      "source": {
        "type": "binary",
        "path": "ransomware_controls/bin/fixture.exe"
      },
      "launch": {
        "args": [
          "burst"
        ],
        "scanSeconds": 25,
        "useKernelDriver": true,
        "useUsermodeHooks": true
      },
      "expected": {
        "required": [],
        "forbidden": [
          "RANSOMWARE_ENTROPY_BURST"
        ]
      }
    },
